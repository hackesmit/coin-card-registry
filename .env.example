# Copy to .env (or set in your host's env) to enable REAL eBay sold prices.
# Without it, the app runs in DEMO mode with realistic mock prices so everything works.
#
# Get a key (free tier = 100 lookups/month) at https://sold-comps.com/
SOLDCOMPS_API_KEY=

# Optional: port for the local server (default 3000)
# PORT=3000
